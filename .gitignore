# ==============================================================================
# Git Ignore Configuration for LabDistrib
# ==============================================================================
# This file specifies intentionally untracked files that Git should ignore.
# As a student learning full-stack development, remember:
# 1. Never commit credentials, passwords, or secret API keys.
# 2. Never commit build outputs or compiled binaries (target/, *.class, *.jar).
# 3. Never commit IDE-specific configurations that can conflict across editors.
# 4. Never commit local OS-generated clutter (Thumbs.db, .DS_Store).
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
# Sensitive files containing database passwords, JWT secret keys, or local secrets.
# These should NEVER be pushed to GitHub to protect database and server security.
.env
*.env
.env.*
application-local.properties
application-secret.properties
secrets/

# ------------------------------------------------------------------------------
# Java & Maven Build Artifacts
# ------------------------------------------------------------------------------
# Generated bytecode (*.class) and packaged binaries (*.jar, *.war) produced by Maven.
# The `target/` directory contains compiled output and can always be recreated with `mvn clean package`.
# Also ignores Java crash log dumps (hs_err_pid*).
target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*

# ------------------------------------------------------------------------------
# IDE Configuration: IntelliJ IDEA
# ------------------------------------------------------------------------------
# Project metadata generated by IntelliJ IDEA. Different developers or computers
# may have different SDK paths, so these files should remain local.
.idea/
*.iml
*.iws
*.ipr
out/

# ------------------------------------------------------------------------------
# IDE Configuration: Eclipse
# ------------------------------------------------------------------------------
# Project metadata and compiled binaries generated by Eclipse or Spring Tool Suite (STS).
.project
.classpath
.settings/
bin/

# ------------------------------------------------------------------------------
# IDE Configuration: Visual Studio Code
# ------------------------------------------------------------------------------
# Workspace configuration files and editor extensions for VS Code.
.vscode/

# ------------------------------------------------------------------------------
# IDE Configuration: Apache NetBeans
# ------------------------------------------------------------------------------
# Project metadata and build artifacts generated by NetBeans.
nbproject/
nbbuild/
nbdist/
nb-configuration.xml

# ------------------------------------------------------------------------------
# Operating System Clutter
# ------------------------------------------------------------------------------
# Hidden system files created automatically by Windows or macOS file explorers.
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# Application Logs
# ------------------------------------------------------------------------------
# Runtime log outputs generated by Spring Boot or logback/log4j.
# Logs can grow large and contain timestamped runtime information.
logs/
*.log

# ------------------------------------------------------------------------------
# Temporary & Backup Files
# ------------------------------------------------------------------------------
# Temporary workspace files, text editor swap files, and backups.
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# ------------------------------------------------------------------------------
# Node.js Dependencies
# ------------------------------------------------------------------------------
# We use vanilla JavaScript (no npm frameworks required), but if npm is accidentally
# run or tools are initialized, keep node_modules from being tracked.
node_modules/

# ------------------------------------------------------------------------------
# Database Dumps & SQL Scripts
# ------------------------------------------------------------------------------
# Ignore random database dumps or exports that might contain sensitive production data.
# Whitelist our official, version-controlled schema and seed data files.
*.sql
!database/schema.sql
!database/seed.sql
